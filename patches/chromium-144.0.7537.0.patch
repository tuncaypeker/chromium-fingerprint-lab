+  for (std::string& line : lines) {
+    bool had_cr = !line.empty() && line.back() == '\r';
+    std::string comparable = had_cr ? line.substr(0, line.size() - 1) : line;
+    if (base::StartsWith(comparable, "a=candidate:",
+                         base::CompareCase::SENSITIVE) &&
+        IsMaskedIpCandidateLine(comparable))
+      continue;
+
+    filtered_lines.push_back(line);
+  }
+
+  return String::FromUTF8(base::JoinString(filtered_lines, "\n"));
+}
