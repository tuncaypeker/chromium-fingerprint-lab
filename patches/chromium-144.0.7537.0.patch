+std::optional<PermissionStatus> ParsePermissionStatusOverride(
+    const std::string& value) {
+  if (base::EqualsCaseInsensitiveASCII(value, "native")) {
+    return std::nullopt;
+  }
+  if (base::EqualsCaseInsensitiveASCII(value, "granted") ||
+      base::EqualsCaseInsensitiveASCII(value, "allow")) {
+    return PermissionStatus::GRANTED;
+  }
+  if (base::EqualsCaseInsensitiveASCII(value, "denied") ||
+      base::EqualsCaseInsensitiveASCII(value, "blocked") ||
+      base::EqualsCaseInsensitiveASCII(value, "block")) {
+    return PermissionStatus::DENIED;
+  }
+  if (base::EqualsCaseInsensitiveASCII(value, "prompt") ||
+      base::EqualsCaseInsensitiveASCII(value, "ask")) {
+    return PermissionStatus::ASK;
+  }
+  return std::nullopt;
