diff --git a/base/weblim/fingerprint_config.cc b/base/weblim/fingerprint_config.cc
new file mode 100644
index 0000000000000000000000000000000000000000..a31ad39f150d50d2ae6e563224e58190ee1829e7
--- /dev/null
+++ b/base/weblim/fingerprint_config.cc
@@ -0,0 +1,154 @@
+// Copyright 2026 Webilim
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "base/weblim/fingerprint_config.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/synchronization/lock.h"
+#include "base/values.h"
+
+namespace base::weblim {
+namespace {
+
+constexpr char kUserDataDirSwitch[] = "user-data-dir";
+constexpr char kConfigFileName[] = "weblm-fingerprint.json";
+
+class FingerprintConfigCache {
+ public:
+  FingerprintConfigCache() = default;
+  FingerprintConfigCache(const FingerprintConfigCache&) = delete;
+  FingerprintConfigCache& operator=(const FingerprintConfigCache&) = delete;
+
+  std::optional<std::string> GetString(std::string_view key) {
+    base::AutoLock auto_lock(lock_);
+    EnsureLoaded();
+    if (!dict_)
+      return std::nullopt;
+
+    const std::string* value = dict_->FindString(key);
+    if (!value)
+      return std::nullopt;
+    return *value;
+  }
+
+  std::optional<std::string> GetJson(std::string_view key) {
+    base::AutoLock auto_lock(lock_);
+    EnsureLoaded();
+    if (!dict_)
+      return std::nullopt;
+
+    const base::Value* value = dict_->Find(key);
+    if (!value)
+      return std::nullopt;
+
+    std::string json;
+    if (!base::JSONWriter::Write(*value, &json))
+      return std::nullopt;
+    return json;
+  }
+
+  std::optional<int> GetInt(std::string_view key) {
+    base::AutoLock auto_lock(lock_);
+    EnsureLoaded();
+    if (!dict_)
+      return std::nullopt;
+
+    std::optional<int> value = dict_->FindInt(key);
+    if (value)
+      return *value;
+
+    const std::string* string_value = dict_->FindString(key);
+    int parsed = 0;
+    if (string_value && base::StringToInt(*string_value, &parsed))
+      return parsed;
+
+    return std::nullopt;
+  }
+
+  std::optional<double> GetDouble(std::string_view key) {
+    base::AutoLock auto_lock(lock_);
+    EnsureLoaded();
+    if (!dict_)
+      return std::nullopt;
+
+    std::optional<double> value = dict_->FindDouble(key);
+    if (value)
+      return *value;
+
+    const std::string* string_value = dict_->FindString(key);
+    double parsed = 0;
+    if (string_value && base::StringToDouble(*string_value, &parsed))
+      return parsed;
+
+    return std::nullopt;
+  }
+
+ private:
+  void EnsureLoaded() {
+    if (loaded_)
+      return;
+    loaded_ = true;
+
+    const base::CommandLine* command_line =
+        base::CommandLine::ForCurrentProcess();
+    if (!command_line)
+      return;
+
+    base::FilePath user_data_dir =
+        command_line->GetSwitchValuePath(kUserDataDirSwitch);
+    if (user_data_dir.empty())
+      return;
+
+    std::string json;
+    if (!base::ReadFileToString(user_data_dir.AppendASCII(kConfigFileName),
+                                &json)) {
+      return;
+    }
+
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(json, base::JSON_ALLOW_TRAILING_COMMAS);
+    if (!parsed || !parsed->is_dict())
+      return;
+
+    dict_.emplace(std::move(parsed->GetDict()));
+  }
+
+  base::Lock lock_;
+  bool loaded_ = false;
+  std::optional<base::Value::Dict> dict_;
+};
+
+FingerprintConfigCache& GetCache() {
+  static base::NoDestructor<FingerprintConfigCache> cache;
+  return *cache;
+}
+
+}  // namespace
+
+std::optional<std::string> GetFingerprintConfigString(std::string_view key) {
+  return GetCache().GetString(key);
+}
+
+std::optional<std::string> GetFingerprintConfigJson(std::string_view key) {
+  return GetCache().GetJson(key);
+}
+
+std::optional<int> GetFingerprintConfigInt(std::string_view key) {
+  return GetCache().GetInt(key);
+}
+
+std::optional<double> GetFingerprintConfigDouble(std::string_view key) {
+  return GetCache().GetDouble(key);
+}
+
+}  // namespace base::weblim
