+
+uint32_t HashWebilimTimingSeed(const std::string& seed) {
+  uint32_t hash = 2166136261u;
+  for (unsigned char c : seed) {
+    hash ^= c;
+    hash *= 16777619u;
+  }
+  return hash;
+}
